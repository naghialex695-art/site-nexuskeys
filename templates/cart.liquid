{% layout 'theme' %}

<div class="container section" aria-labelledby="cart-title">
  <h1 id="cart-title" style="margin-bottom:2rem">Cosul meu</h1>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart -%}
      <div class="cart-layout">
        <!-- Items -->
        <div>
          {%- for item in cart.items -%}
            <div class="cart-item" aria-label="{{ item.product.title }}">
              <a href="{{ item.url }}" class="cart-item__img" tabindex="-1" aria-hidden="true">
                <img
                  src="{{ item.image | image_url: width: 160 }}"
                  alt="{{ item.image.alt | default: item.product.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title }}</a>
                <div class="cart-item__price">{{ item.final_price | money }}</div>
                <button
                  type="button"
                  class="cart-item__remove"
                  data-remove-item="{{ forloop.index }}"
                  aria-label="Sterge {{ item.product.title }} din cos"
                >
                  Sterge
                </button>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Summary -->
        <div class="cart-summary" aria-labelledby="summary-title">
          <h2 id="summary-title" style="font-size:1.125rem;margin-bottom:1rem">Rezumat comanda</h2>

          <div class="cart-summary__row">
            <span>Produse ({{ cart.item_count }})</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-summary__row">
            <span>Livrare</span>
            <span style="color:var(--color-success);font-weight:600">Gratuita (instant email)</span>
          </div>
          <div class="cart-summary__row cart-summary__row--total">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <button type="submit" name="checkout" class="btn btn--primary btn--lg cart-checkout-btn" aria-label="Continua la plata">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            Continua la plata
          </button>

          <p style="font-size:.8125rem;color:var(--color-text-muted);text-align:center;margin-top:.75rem">
            🔒 Plata securizata SSL — banii tai sunt in siguranta
          </p>
        </div>
      </div>
    {%- endform -%}

  {%- else -%}
    <div class="cart-empty">
      <div class="cart-empty__icon" aria-hidden="true">🛒</div>
      <h2 style="margin-bottom:.5rem">Cosul tau este gol</h2>
      <p>Adauga produse din catalogul nostru pentru a continua.</p>
      <a href="/collections/all" class="btn btn--primary btn--lg">
        Exploreaza produsele
      </a>
    </div>
  {%- endif -%}
</div>
