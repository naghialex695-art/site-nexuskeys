<div class="container section">
  <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem">
    {%- render 'breadcrumb' -%}
  </nav>

  <div class="product-layout">
    <!-- Media -->
    <div class="product-media">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="800"
          height="800"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:var(--color-highlight)">
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
      {%- endif -%}
    </div>

    <!-- Info -->
    <div class="product-info">
      <div class="product-info__category">
        {%- for tag in product.tags -%}
          {%- if forloop.first -%}{{ tag }}{%- endif -%}
        {%- endfor -%}
      </div>

      <h1 class="product-info__title">{{ product.title }}</h1>

      <div class="product-info__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="price__sale" aria-label="Pret: {{ product.price | money }}">{{ product.price | money }}</span>
          <span class="price__compare" aria-label="Pret initial: {{ product.compare_at_price | money }}">{{ product.compare_at_price | money }}</span>
          {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          <span class="price__discount" aria-label="Reducere {{ discount }}%">-{{ discount }}%</span>
        {%- else -%}
          <span class="price__regular">{{ product.price | money }}</span>
        {%- endif -%}
      </div>

      <!-- Features -->
      <ul class="product-features" aria-label="Caracteristici produs">
        <li class="product-feature">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          Livrare instant prin email
        </li>
        <li class="product-feature">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Licenta Microsoft originala 100%
        </li>
        <li class="product-feature">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Garantie 30 de zile — banii inapoi
        </li>
        <li class="product-feature">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          Support tehnic dedicat
        </li>
      </ul>

      <!-- Add to Cart Form -->
      {%- form 'product', product, data-atc-form: '' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="product-atc-form">
          {%- if product.available -%}
            <button
              type="submit"
              class="btn btn--primary btn--lg product-atc-btn"
              data-atc-btn
              aria-label="Adauga {{ product.title }} in cos"
            >
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
              Adauga in cos — {{ product.price | money }}
            </button>
          {%- else -%}
            <button type="button" class="btn btn--outline btn--lg product-atc-btn" disabled aria-disabled="true">
              Stoc epuizat
            </button>
          {%- endif -%}
        </div>
      {%- endform -%}

      <!-- Guarantee -->
      <div class="product-guarantee" role="note" aria-label="Garantie">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span><strong>Garantie 30 de zile.</strong> Daca cheia nu functioneaza, iti returnam banii integral fara intrebari.</span>
      </div>
    </div>
  </div>

  <!-- Product Tabs -->
  <div class="product-tabs" role="tablist" aria-label="Informatii produs">
    <div class="product-tabs__nav">
      <button class="product-tab-btn is-active" data-tab="tab-desc" role="tab" aria-selected="true" aria-controls="tab-desc" id="btn-desc">
        Descriere
      </button>
      <button class="product-tab-btn" data-tab="tab-install" role="tab" aria-selected="false" aria-controls="tab-install" id="btn-install">
        Ghid instalare
      </button>
      <button class="product-tab-btn" data-tab="tab-faq" role="tab" aria-selected="false" aria-controls="tab-faq" id="btn-faq">
        Intrebari frecvente
      </button>
    </div>

    <div id="tab-desc" class="product-tab-panel is-active" role="tabpanel" aria-labelledby="btn-desc">
      <div class="product-tab-content">
        {{ product.description }}
      </div>
    </div>

    <div id="tab-install" class="product-tab-panel" role="tabpanel" aria-labelledby="btn-install">
      <div class="product-tab-content">
        <ol style="padding-left:1.5rem;display:flex;flex-direction:column;gap:.75rem">
          <li>Dupa plata, vei primi cheia de activare pe adresa de email in cateva secunde.</li>
          <li>Deschide produsul Microsoft instalat pe calculator (ex: Windows Settings sau Word).</li>
          <li>Mergi la <strong>Activare</strong> si introdu cheia primita prin email.</li>
          <li>Produsul se va activa automat daca esti conectat la internet.</li>
          <li>In caz de probleme, contacteaza-ne la support@nexuskey.ro — raspundem in maxim 2 ore.</li>
        </ol>
      </div>
    </div>

    <div id="tab-faq" class="product-tab-panel" role="tabpanel" aria-labelledby="btn-faq">
      <div class="product-tab-content">
        <div style="display:flex;flex-direction:column;gap:1.25rem">
          <div>
            <strong>Cat timp dureaza livrarea?</strong>
            <p style="margin-top:.25rem">Instant — cheia apare in email in secunde dupa confirmarea platii.</p>
          </div>
          <div>
            <strong>Licenta functioneaza pe mai multe PC-uri?</strong>
            <p style="margin-top:.25rem">Depinde de tipul licentei. OEM = 1 PC, Retail = poti transfera pe alt PC.</p>
          </div>
          <div>
            <strong>Ce fac daca cheia nu functioneaza?</strong>
            <p style="margin-top:.25rem">Ne contactezi si iti trimitem o cheie noua sau iti returnam banii in 24h.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pagina Produs",
  "settings": []
}
{% endschema %}
