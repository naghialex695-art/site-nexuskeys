<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__badges">
      <span class="badge badge--success" style="background:rgba(255,255,255,.15);color:#fff">
        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="margin-right:4px"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Licente 100% Originale
      </span>
      <span class="badge" style="background:rgba(255,255,255,.15);color:#fff">
        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="margin-right:4px"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Livrare Instant
      </span>
      <span class="badge" style="background:rgba(255,255,255,.15);color:#fff">
        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="margin-right:4px"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Garantie 30 Zile
      </span>
    </div>

    <h1 class="hero__title" id="hero-title">
      {{ section.settings.title | default: 'Licente Microsoft la Preturi Imbatabile' }}
    </h1>

    <p class="hero__subtitle">
      {{ section.settings.subtitle | default: 'Windows 11, Office 2024 si alte licente originale. Activare instant, economii de pana la 80%.' }}
    </p>

    <div class="hero__cta">
      <a href="/collections/all" class="btn btn--white btn--lg">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 6h16M4 12h16M4 18h7"/></svg>
        Vezi toate produsele
      </a>
      <a href="/collections/bundles" class="btn btn--lg" style="background:rgba(255,255,255,.15);color:#fff;border:1.5px solid rgba(255,255,255,.4)">
        Oferte speciale
      </a>
    </div>

    <div class="hero__stats">
      <div class="hero__stat">
        <div class="hero__stat-num">5000+</div>
        <div class="hero__stat-label">Clienti multumiti</div>
      </div>
      <div class="hero__stat">
        <div class="hero__stat-num">4.9★</div>
        <div class="hero__stat-label">Rating mediu</div>
      </div>
      <div class="hero__stat">
        <div class="hero__stat-num">80%</div>
        <div class="hero__stat-label">Economii maxime</div>
      </div>
      <div class="hero__stat">
        <div class="hero__stat-num">24/7</div>
        <div class="hero__stat-label">Livrare automata</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titlu",
      "default": "Licente Microsoft la Preturi Imbatabile"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitlu",
      "default": "Windows 11, Office 2024 si alte licente originale. Activare instant, economii de pana la 80%."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
