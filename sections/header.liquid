<header class="site-header" role="banner">
  <div class="container">
    <!-- Logo -->
    <a href="/" class="site-logo" aria-label="{{ shop.name }} — Acasa">
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="28" height="28" rx="6" fill="#1D4ED8"/>
        <path d="M14 6L20 10V14C20 17.31 17.31 21 14 22C10.69 21 8 17.31 8 14V10L14 6Z" fill="white" fill-opacity="0.9"/>
        <path d="M12 14l2 2 4-4" stroke="#1D4ED8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>NexusKey</span>
    </a>

    <!-- Nav Desktop -->
    <nav class="header-nav" aria-label="Navigare principala">
      <a href="/collections/windows" {% if request.path contains '/collections/windows' %}aria-current="page"{% endif %}>Windows</a>
      <a href="/collections/office" {% if request.path contains '/collections/office' %}aria-current="page"{% endif %}>Office</a>
      <a href="/collections/bundles" {% if request.path contains '/collections/bundles' %}aria-current="page"{% endif %}>Pachete</a>
      <a href="/collections/professional" {% if request.path contains '/collections/professional' %}aria-current="page"{% endif %}>Professional</a>
      <a href="/pages/cum-functioneaza" {% if request.path contains '/pages/cum-functioneaza' %}aria-current="page"{% endif %}>Cum functioneaza</a>
    </nav>

    <!-- Actions -->
    <div class="header-actions">

      <!-- Search -->
      <button class="header-icon-btn" id="search-toggle" aria-label="Cauta produse" aria-expanded="false" aria-controls="search-overlay">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Language -->
      {%- if localization.available_languages.size > 1 -%}
      <div class="header-lang" aria-label="Selecteaza limba">
        <button class="header-icon-btn header-lang__btn" aria-haspopup="listbox" aria-expanded="false" id="lang-toggle">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span class="header-lang__code">{{ localization.language.iso_code | upcase }}</span>
        </button>
        <ul class="header-lang__dropdown" role="listbox" aria-labelledby="lang-toggle">
          {%- form 'localization', class: 'header-lang__form' -%}
            {%- for language in localization.available_languages -%}
            <li role="option" {% if language.iso_code == localization.language.iso_code %}aria-selected="true"{% endif %}>
              <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="header-lang__option">
                {{ language.endonym_name }}
              </button>
            </li>
            {%- endfor -%}
          {%- endform -%}
        </ul>
      </div>
      {%- else -%}
      <div class="header-lang-static" aria-label="Limba: Romana">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        <span>RO</span>
      </div>
      {%- endif -%}

      <!-- Cart -->
      <a href="/cart" class="header-cart" aria-label="Cos cumparaturi ({{ cart.item_count }} produse)">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="header-cart__count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </a>

      <!-- Account -->
      <a href="{%- if customer -%}/account{%- else -%}/account/login{%- endif -%}" class="header-icon-btn" aria-label="{%- if customer -%}Contul meu{%- else -%}Autentificare{%- endif -%}">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
        {%- if customer -%}
        <span class="header-account__indicator" aria-hidden="true"></span>
        {%- endif -%}
      </a>

      <!-- Mobile menu button -->
      <button
        class="mobile-menu-btn"
        id="mobile-menu-btn"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Deschide meniu"
      >
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Search Overlay -->
<div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-label="Cauta produse">
  <div class="search-overlay__inner">
    <form action="/search" method="get" class="search-overlay__form" role="search">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        id="search-input"
        class="search-overlay__input"
        placeholder="Cauta licente software..."
        autocomplete="off"
        aria-label="Termen de cautare"
      >
      <button type="submit" class="search-overlay__submit" aria-label="Cauta">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
    </form>
    <button class="search-overlay__close" id="search-close" aria-label="Inchide cautarea">
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</div>

<!-- Mobile Nav -->
<nav class="mobile-nav" id="mobile-nav" aria-label="Meniu mobil">
  <a href="/collections/windows">Windows</a>
  <a href="/collections/office">Office</a>
  <a href="/collections/bundles">Pachete Promotionale</a>
  <a href="/collections/professional">Professional</a>
  <a href="/pages/cum-functioneaza">Cum functioneaza</a>
  <a href="/cart">Cosul meu ({{ cart.item_count }})</a>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
