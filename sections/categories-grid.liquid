<section class="section" aria-labelledby="categories-title">
  <div class="container">
    <h2 class="section-title" id="categories-title">
      Categorii <span>Populare</span>
    </h2>

    <div class="categories-grid">
      <a href="/collections/windows" class="category-card">
        <div class="category-card__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 5.557L10.065 4.5v7.065H3V5.557zM10.932 4.371L21 2.85v8.713h-10.068V4.371zM3 12.431h7.065V19.5L3 18.443V12.431zM10.932 12.559H21v8.713l-10.068-1.522V12.559z"/>
          </svg>
        </div>
        <div class="category-card__name">Windows</div>
        <div class="category-card__count">7 produse</div>
      </a>

      <a href="/collections/office" class="category-card">
        <div class="category-card__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.5 2h11A1.5 1.5 0 0119 3.5v17a1.5 1.5 0 01-1.5 1.5h-11A1.5 1.5 0 015 20.5v-17A1.5 1.5 0 016.5 2zM8 7h8M8 11h8M8 15h5"/>
          </svg>
        </div>
        <div class="category-card__name">Office</div>
        <div class="category-card__count">6 produse</div>
      </a>

      <a href="/collections/bundles" class="category-card">
        <div class="category-card__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2"/>
            <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
            <line x1="12" y1="12" x2="12" y2="16"/>
            <line x1="10" y1="14" x2="14" y2="14"/>
          </svg>
        </div>
        <div class="category-card__name">Pachete</div>
        <div class="category-card__count">4 produse</div>
      </a>

      <a href="/collections/professional" class="category-card">
        <div class="category-card__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
        </div>
        <div class="category-card__name">Professional</div>
        <div class="category-card__count">5 produse</div>
      </a>
    </div>
  </div>
</section>

