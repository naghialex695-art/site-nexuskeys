<section class="section" style="background:var(--color-highlight)" aria-labelledby="how-title">
  <div class="container">
    <h2 class="section-title" id="how-title">Cum <span>Functioneaza</span></h2>
    <div class="how-steps">
      <div class="how-step">
        <div class="how-step__num" aria-hidden="true">1</div>
        <h3 class="how-step__title">Alege produsul</h3>
        <p class="how-step__desc">Selecteaza licenta software dorita din catalogul nostru si adaug-o in cos. Toate produsele sunt originale Microsoft.</p>
      </div>
      <div class="how-step">
        <div class="how-step__num" aria-hidden="true">2</div>
        <h3 class="how-step__title">Plateste securizat</h3>
        <p class="how-step__desc">Alege metoda de plata preferata: card bancar sau PayPal. Tranzactia este protejata prin criptare SSL 256-bit.</p>
      </div>
      <div class="how-step">
        <div class="how-step__num" aria-hidden="true">3</div>
        <h3 class="how-step__title">Primesti cheia instant</h3>
        <p class="how-step__desc">Imediat dupa plata primesti cheia de activare pe email. Activarea se face in cateva minute direct din Windows/Office.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cum Functioneaza",
  "settings": [],
  "presets": [
    {
      "name": "Cum Functioneaza"
    }
  ]
}
{% endschema %}
